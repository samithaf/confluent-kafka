# Confluent Cloud connection
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-central1.gcp.confluent.cloud:9092
KAFKA_API_KEY=replace-with-confluent-api-key
KAFKA_API_SECRET=replace-with-confluent-api-secret

# Topics
# Producer: KAFKA_TOPIC is required.
# Consumer: either KAFKA_TOPIC or a comma-separated KAFKA_TOPICS is accepted.
KAFKA_TOPIC=orders.v1
# KAFKA_TOPICS=orders.v1,payments.v1

# Consumer only
KAFKA_CONSUMER_GROUP=orders-service
# Use "classic" if your cluster does not support the new consumer group protocol.
KAFKA_GROUP_PROTOCOL=consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_PARTITIONS_CONSUMED_CONCURRENTLY=4
KAFKA_COMMIT_INTERVAL_MESSAGES=100

# Client identity and runtime
KAFKA_CLIENT_ID=cloud-run-kafka
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=8000

# Optional: supplied automatically by Cloud Run
# K_SERVICE=producer-service
# K_REVISION=producer-service-00001-abc
# GOOGLE_CLOUD_REGION=us-central1
